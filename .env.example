# Keycloak Configuration
VITE_KEYCLOAK_URL=https://keycloak.k8s.local
VITE_KEYCLOAK_REALM=LSADF
VITE_KEYCLOAK_CLIENT_ID=lsadf-admin-ui

# API Configuration
VITE_SIMPLE_REST_URL=http://localhost:8080/api

# Instructions:
# 1. Copy this file to .env in the project root
# 2. Update the values according to your environment
# 3. Make sure Keycloak is configured with:
#    - Realm: LSADF
#    - Client: lsadf-admin-ui
#    - Valid redirect URIs: http://localhost:5173/* (for development)
#    - Web origins: http://localhost:5173
